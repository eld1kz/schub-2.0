{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local": "bash scripts/db-local.sh",
    "dev:local": "set -a && . ./.env.test.local && set +a && NEXT_DIST_DIR=.next-local next dev -p 3101",
    "test": "vitest run",
    "test:db": "npm run db:local && vitest run --config vitest.db.config.ts",
    "test:e2e": "npm run db:local && playwright test",
    "test:visual": "bash scripts/visual.sh",
    "test:visual:update": "bash scripts/visual.sh --update-snapshots",
    "import:opportunities": "tsx scripts/import-opportunities.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
